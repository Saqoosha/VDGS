<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 is present on every Windows 10 and 11, so the download stays a
         couple of megabytes and nobody is asked to install a runtime before they can fly. -->
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>VDGS</AssemblyName>
    <RootNamespace>VDGSCompanion</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- Built from macOS, so the RID has to be named or only the Darwin build of the
         native SQLite library is copied and the app dies on first use on Windows. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <Version>2026.8.24</Version>
    <Product>VDGS Companion</Product>
    <Company>Saqoosha</Company>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project compiles this project's sources itself; without excluding it, the
         default **/*.cs glob also pulls in its generated AssemblyInfo and the build fails
         on duplicate attributes. -->
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- .NET Framework keeps zip handling in its own assemblies, referenced by name. -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the Windows-only target build from macOS. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.10" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.10" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <!-- The window's interface is the same React app the mod serves in the browser, built
       by bun. It is copied in rather than referenced so the shipped app is one folder,
       and the copy is conditional so a C#-only build does not fail on a missing dist. -->
  <Target Name="CopyUi" AfterTargets="Build" Condition="Exists('$(MSBuildProjectDirectory)/../web/dist/companion.html')">
    <!-- Emptied first, for the same reason CopyMod is: a bare Copy never removes, and
         every asset carries a per-build content hash, so each rebuild left the previous
         build's scripts beside the new ones. Measured before the fix: 62 js/css in the
         window's own ui against 6 in the source, 94 asset files in total, all of them
         shipped in the companion zip. companion.html names only the current chunks, so
         nothing broke and nothing said anything. -->
    <ItemGroup>
      <StaleUi Include="$(OutDir)ui/**/*" />
    </ItemGroup>
    <Delete Files="@(StaleUi)" />
    <RemoveDir Directories="$(OutDir)ui" />
    <ItemGroup>
      <UiFiles Include="$(MSBuildProjectDirectory)/../web/dist/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(UiFiles)"
          DestinationFiles="@(UiFiles->'$(OutDir)ui/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <!-- The mod this app hands out, staged by tools/make-release.sh. Conditional so a
       C#-only build still works; the app reports the payload as absent rather than
       pretending it can install one. -->
  <Target Name="CopyMod" AfterTargets="Build" Condition="Exists('$(MSBuildProjectDirectory)/../build/release/vdgs-mod/BepInEx/plugins/VDGS.dll')">
    <!-- Emptied first. Copy never removes, and the interface is fingerprinted per build,
         so every rebuild left the last one's scripts beside the new ones: twenty-three in
         the payload against five in the source, all of them shipped in the zip and copied
         into the game. Nothing broke - index.html names only the current pair - which is
         why it went unnoticed until an install was counted. -->
    <ItemGroup>
      <StalePayload Include="$(OutDir)mod/**/*" />
    </ItemGroup>
    <Delete Files="@(StalePayload)" />
    <RemoveDir Directories="$(OutDir)mod" />
    <ItemGroup>
      <ModFiles Include="$(MSBuildProjectDirectory)/../build/release/vdgs-mod/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(ModFiles)"
          DestinationFiles="@(ModFiles->'$(OutDir)mod/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
