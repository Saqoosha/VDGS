<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Only whatever .NET the machine happens to carry is installed, and a test
         project that cannot start is worse than one pinned a version behind. -->
    <RollForward>LatestMajor</RollForward>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>VDGS.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\VDGS\VdgsPaths.cs" Link="VdgsPaths.cs" />
    <Compile Include="..\VDGS\SplatMetaFile.cs" Link="SplatMetaFile.cs" />
  </ItemGroup>
</Project>
