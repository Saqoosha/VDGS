<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>VDGS</AssemblyName>
    <RootNamespace>VDGS</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>
    <!-- BepInEx plugins are loaded from disk; no deps.json / satellite output wanted. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
    <!-- Game assemblies are obfuscated in places; don't fail the build on their metadata. -->
    <NoWarn>$(NoWarn);CS0436;NU1701</NoWarn>
  </PropertyGroup>

  <!-- Reference assemblies pulled off the Windows install (lib/ is gitignored). -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>..\..\lib\bepinex\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\..\lib\bepinex\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>..\..\lib\unity\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\lib\unity\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>..\..\lib\unity\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>..\..\lib\unity\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>..\..\lib\unity\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>..\..\lib\unity\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>..\..\lib\unity\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Only used to switch off Auto Exposure, which cannot work under -force-d3d12. -->
    <Reference Include="Unity.Postprocessing.Runtime">
      <HintPath>..\..\lib\unity\Unity.Postprocessing.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Shipped by the game. JsonUtility cannot serialise dictionaries and silently
         writes "{}" for nested types, so bindings use Newtonsoft instead. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\..\lib\unity\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
