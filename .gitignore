# build output
bin/
obj/
build/
web/dist/
web/node_modules/

# prebuilt shader bundle staged for packaging; tools/package.sh fetches it
# from the Windows box, and released zips live on GitHub Releases
dist/payload/

# reference assemblies pulled off the game install. Anchored: an unanchored `lib/`
# also swallows web/src/lib/, which is where shadcn puts the `cn` helper that every
# generated component imports.
/lib/

# machine-specific SSH target for deploy / bake / launch
tools/local.env

# upstream checkout. スラッシュ無し —— 実体がシンボリックリンクなので
# `vendor/` では当たらず、git status に出続けていた
vendor

# decompiled game code (27MB dll -> 73MB of C#)
research/decompiled/
research/decompile.log

# Unity
unity/*/Library/
unity/*/Temp/
unity/*/Logs/
unity/*/UserSettings/
unity/*/obj/
unity/*/*.sln
unity/*/*.csproj
unity/*/Assets/GaussianAssets/
# Mono writes these next to the project when the editor dies. One was committed
# once - 181 KB of stack frames nothing reads.
unity/*/mono_crash.*.json

*.user
.DS_Store

# Companion app build output
companion/bin/
companion/obj/
companion/tests/bin/
companion/tests/obj/

companion-tauri/src-tauri/target/
companion-tauri/src-tauri/resources/mod/

# Worker dependencies and wrangler's own cache, which names the account it is signed
# into - machine state, not the project's
worker/node_modules/
.wrangler/
companion-tauri/src-tauri/gen/
