# Copy to tools/local.env (gitignored) and fill in. Used by deploy / bake / launch.
VDGS_HOST=user@windows-box
# Optional. The helpers default to %USERPROFILE%\Downloads\Velocidrone Windows Launcher\app
# VDGS_GAME=C:\Users\you\Downloads\Velocidrone Windows Launcher\app
# Optional WSL distro name for tools/wsl.sh and tools/preview.sh
# VDGS_WSL_DISTRO=Ubuntu-24.04
# The Windows box that BUILDS the companion. Not the same machine as VDGS_HOST: the game
# box has VelociDrone and Unity, this one needs Rust (x86_64-pc-windows-msvc), Visual
# Studio's linker and cargo-tauri. Used by tools/make-win-app.sh only.
# VDGS_WIN_BUILD_HOST=user@build-box
